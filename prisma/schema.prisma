generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// -------------------------------------------------------------
// USER & ROLE-BASED ACCESS CONTROL (RBAC)
// -------------------------------------------------------------
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         String    @default("TEACHER") // PRINCIPAL, ACCOUNTANT, TEACHER, PARENT, STUDENT
  name         String
  avatar       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  teacher      Teacher?
  parent       Parent?
  student      Student?
}

// -------------------------------------------------------------
// ACADEMIC STRUCTURE: CLASSES, SECTIONS & SUBJECTS
// -------------------------------------------------------------
model AcademicYear {
  id        String   @id @default(cuid())
  name      String   @unique // e.g. "2026-2027"
  isCurrent Boolean  @default(true)
  startDate String
  endDate   String
}

model GradeClass {
  id          String   @id @default(cuid())
  name        String   // e.g. "Grade 10"
  section     String   // e.g. "A"
  roomNumber  String?
  capacity    Int      @default(40)
  classTeacherId String? @unique
  classTeacher Teacher? @relation("ClassTeacher", fields: [classTeacherId], references: [id])

  students    Student[]
  attendances StudentAttendance[]
  feeStructures FeeStructure[]
}

model Subject {
  id          String   @id @default(cuid())
  name        String   // e.g. "Mathematics", "Physics", "English"
  code        String   @unique // e.g. "MTH-10"
  credits     Int      @default(4)
  examResults ExamResult[]
}

model Teacher {
  id           String      @id @default(cuid())
  userId       String?     @unique
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  employeeCode String      @unique // e.g. "TCH-01"
  firstName    String
  lastName     String
  email        String      @unique
  phone        String?
  avatar       String?
  qualification String?    // e.g. "M.Sc. Physics, B.Ed."
  joiningDate  String
  managedClass GradeClass? @relation("ClassTeacher")
}

// -------------------------------------------------------------
// STUDENT & GUARDIAN / PARENT 360° RECORDS
// -------------------------------------------------------------
model Parent {
  id           String    @id @default(cuid())
  userId       String?   @unique
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  fatherName   String
  motherName   String
  primaryPhone String
  email        String?
  occupation   String?
  address      String?

  students     Student[]
}

model Student {
  id              String      @id @default(cuid())
  userId          String?     @unique
  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  admissionNo     String      @unique // e.g. "ADM-2026-084"
  rollNo          Int
  firstName       String
  lastName        String
  dateOfBirth     String      // YYYY-MM-DD
  gender          String      // Male, Female, Other
  bloodGroup      String?     // A+, B+, O+, etc.
  avatar          String?
  address         String?
  emergencyContact String?

  classId         String
  gradeClass      GradeClass  @relation(fields: [classId], references: [id], onDelete: Restrict)

  parentId        String?
  parent          Parent?     @relation(fields: [parentId], references: [id], onDelete: SetNull)

  status          String      @default("ENROLLED") // ENROLLED, SUSPENDED, ALUMNI
  enrollmentDate  String

  attendances     StudentAttendance[]
  feeInvoices     FeeInvoice[]
  feePayments     FeePayment[]
  examResults     ExamResult[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

// -------------------------------------------------------------
// ADMISSION & ENROLLMENT MANAGEMENT
// -------------------------------------------------------------
model AdmissionApplication {
  id              String   @id @default(cuid())
  applicationNo   String   @unique // e.g. "APP-2026-102"
  applicantName   String
  targetGrade     String   // e.g. "Grade 10"
  guardianName    String
  guardianPhone   String
  guardianEmail   String
  previousSchool  String?
  status          String   @default("SUBMITTED") // SUBMITTED, ENTRANCE_TEST, DOCS_VERIFIED, APPROVED, ENROLLED
  testScore       Float?
  appliedDate     DateTime @default(now())
  notes           String?
}

// -------------------------------------------------------------
// ATTENDANCE MANAGEMENT
// -------------------------------------------------------------
model StudentAttendance {
  id          String     @id @default(cuid())
  studentId   String
  student     Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId     String
  gradeClass  GradeClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  date        String     // YYYY-MM-DD
  status      String     @default("PRESENT") // PRESENT, ABSENT, LATE, EXCUSED
  remarks     String?
  createdAt   DateTime   @default(now())

  @@unique([studentId, date])
}

// -------------------------------------------------------------
// FEES & ACCOUNTS MANAGEMENT
// -------------------------------------------------------------
model FeeStructure {
  id          String     @id @default(cuid())
  classId     String
  gradeClass  GradeClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  term        String     // Term 1 (Apr-Jul), Term 2 (Aug-Nov), Term 3 (Dec-Mar)
  tuitionFee  Float
  transportFee Float     @default(0)
  labFee      Float      @default(0)
  libraryFee  Float      @default(0)
  totalAmount Float
}

model FeeInvoice {
  id          String       @id @default(cuid())
  invoiceNo   String       @unique // e.g. "INV-2026-0045"
  studentId   String
  student     Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title       String       // e.g. "Term 1 Academic & Activity Fee"
  amountDue   Float
  amountPaid  Float        @default(0)
  dueDate     String       // YYYY-MM-DD
  status      String       @default("UNPAID") // PAID, PARTIAL, UNPAID, OVERDUE
  createdAt   DateTime     @default(now())

  payments    FeePayment[]
}

model FeePayment {
  id             String     @id @default(cuid())
  receiptNo      String     @unique // e.g. "RCPT-2026-902"
  invoiceId      String
  invoice        FeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  amount         Float
  paymentDate    DateTime   @default(now())
  paymentMethod  String     @default("ONLINE") // ONLINE, UPI, CHEQUE, CASH
  transactionRef String?
}

// -------------------------------------------------------------
// EXAMINATION & ACADEMIC RECORDS
// -------------------------------------------------------------
model Exam {
  id          String       @id @default(cuid())
  name        String       // e.g. "Term 1 Mid-Term Examination"
  term        String       // Term 1, Term 2, Final
  academicYear String      @default("2026-2027")
  startDate   String
  endDate     String
  isPublished Boolean      @default(true)

  results     ExamResult[]
}

model ExamResult {
  id            String   @id @default(cuid())
  examId        String
  exam          Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId     String
  subject       Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  marksObtained Float
  maxMarks      Float    @default(100)
  grade         String   // A1, A2, B1, B2, C1, etc.
  remarks       String?

  @@unique([examId, studentId, subjectId])
}

// -------------------------------------------------------------
// SCHOOL NOTICEBOARD & CIRCULARS
// -------------------------------------------------------------
model SchoolNotice {
  id             String   @id @default(cuid())
  title          String
  content        String
  targetAudience String   @default("ALL") // ALL, PARENTS, TEACHERS, STUDENTS
  isPinned       Boolean  @default(false)
  authorName     String   @default("Principal's Office")
  createdAt      DateTime @default(now())
}
